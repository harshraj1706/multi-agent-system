# CogniSynth Platform Environment Configuration

# Google Gemini LLM API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=gemini-3.6-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4000
LLM_MAX_RETRIES=3
LLM_INITIAL_BACKOFF=2.0

# Tavily AI Search Configuration
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_MAX_RESULTS=4

# Research Bounds & Extraction Limits
MAX_SCRAPED_CHARS=5000
MAX_RESEARCH_CONTEXT_CHARS=30000
REQUEST_TIMEOUT=120

# System Settings & Persistence
DATA_DIR=data
LOG_LEVEL=INFO
ENABLE_HUMAN_APPROVAL=false
